    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "@gradio/client": "^2.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "1.31.0",
    "multer": "^2.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "1.76.0"
  }
